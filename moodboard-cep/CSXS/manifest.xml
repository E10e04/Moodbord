<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   Version="10.0"
                   ExtensionBundleId="com.moodboard.cep"
                   ExtensionBundleName="Moodboard"
                   ExtensionBundleVersion="1.7.0">
  <ExtensionList>
    <Extension Id="com.moodboard.cep.panel" Version="1.7.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.moodboard.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./client/js/adobe/host.script.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Moodboard</Menu>
          <Geometry>
            <Size>
              <Width>1200</Width>
              <Height>800</Height>
            </Size>
            <MinSize>
              <Width>420</Width>
              <Height>320</Height>
            </MinSize>
            <MaxSize>
              <Width>4000</Width>
              <Height>4000</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Std">./client/assets/icon-23.png</Icon>
            <Icon Type="HiDPI">./client/assets/icon-46.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
